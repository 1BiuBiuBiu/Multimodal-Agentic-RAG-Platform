# Copy this file to .env and fill in your values
# Never commit .env to git

# DeepSeek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Tavily web search API key (free at https://tavily.com)
TAVILY_API_KEY=tvly-your-key-here

# Optional: existing local model directories (otherwise download on first use)
# EMBED_MODEL_PATH=C:/path/to/bge-m3
# RERANK_MODEL_PATH=C:/path/to/ms-marco-MiniLM-L6-v2

# MinerU 2.x (install requirements-mineru.txt in an independent environment)
# MINERU_EXECUTABLE=C:/path/to/mineru-env/Scripts/mineru.exe
MINERU_DEVICE=cpu
MINERU_LANG=ch
MINERU_MODEL_SOURCE=huggingface
MINERU_TIMEOUT=1800
# Whole tables are embedded in smaller batches to bound memory consumption.
EMBED_BATCH_SIZE=8
EMBED_BATCH_TOKEN_LIMIT=4096
